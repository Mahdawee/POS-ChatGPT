{
  "name": "@dar-pos/server",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "npm run db:schema && cross-env API_HOST=127.0.0.1 API_PORT=4317 ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "npm run db:schema && npm run db:generate && tsc -p tsconfig.build.json",
    "db:generate": "node scripts/prisma-local.cjs generate",
    "db:push": "node scripts/prisma-local.cjs db push",
    "db:schema": "node scripts/prisma-local.cjs migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output prisma/schema.sql",
    "db:seed": "npm run db:push && ts-node prisma/seed.ts",
    "test": "jest --runInBand --cacheDirectory .jest-cache"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.18",
    "@nestjs/core": "^10.4.18",
    "@nestjs/platform-express": "^10.4.18",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.4",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
