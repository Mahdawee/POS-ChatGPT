generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE
  CREDIT
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE_RETURN
}

enum CashMovementType {
  IN
  OUT
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#7488a3")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String              @id @default(cuid())
  sku         String              @unique
  barcode     String?             @unique
  name        String
  unit        String              @default("عدد")
  isWeighted  Boolean             @default(false)
  expiryDate  DateTime?
  price       Int
  cost        Int                 @default(0)
  stock       Float               @default(0)
  minStock    Float               @default(0)
  isActive    Boolean             @default(true)
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems   SaleItem[]
  movements   InventoryMovement[]
  purchaseItems PurchaseItem[]
  returnItems   SaleReturnItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  @@index([name])
  @@index([categoryId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  note      String?
  isActive  Boolean  @default(true)
  sales     Sale[]
  payments  CustomerPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([phone])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  address   String?
  note      String?
  isActive  Boolean           @default(true)
  purchases Purchase[]
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@index([name])
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  displayName  String
  passwordHash String
  role         UserRole    @default(CASHIER)
  isActive     Boolean     @default(true)
  sales        Sale[]
  cashSessions CashSession[]
  purchases    Purchase[]
  saleReturns  SaleReturn[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Sale {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  idempotencyKey String?       @unique
  subtotal       Int
  discount       Int           @default(0)
  total          Int
  amountPaid     Int
  change         Int           @default(0)
  paymentMethod  PaymentMethod
  note           String?
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  cashSessionId  String?
  cashSession    CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  returns        SaleReturn[]
  createdAt      DateTime      @default(now())
  @@index([createdAt])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  sku       String
  quantity  Float
  unitPrice Int
  unitCost  Int     @default(0)
  lineTotal Int
  @@index([saleId])
}

model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Float
  stockAfter Float
  reference String?
  note      String?
  createdAt DateTime     @default(now())
  @@index([productId, createdAt])
}

model CashSession {
  id          String       @id @default(cuid())
  status      String       @default("OPEN")
  openingCash Int
  expectedCash Int?
  countedCash Int?
  note        String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  sales       Sale[]
  movements   CashMovement[]
  customerPayments CustomerPayment[]
  openedAt    DateTime     @default(now())
  closedAt    DateTime?
  @@index([status, openedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  amount        Int
  description   String
  cashSessionId String
  cashSession   CashSession       @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  @@index([cashSessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
  @@index([entity, createdAt])
}

model Purchase {
  id         String         @id @default(cuid())
  invoiceNo  String?
  note       String?
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  total      Int
  paidAmount Int            @default(0)
  items      PurchaseItem[]
  createdAt  DateTime       @default(now())
  @@index([createdAt])
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  sku        String
  quantity   Float
  unitCost   Int
  lineTotal  Int
  @@index([purchaseId])
}

model SaleReturn {
  id        String          @id @default(cuid())
  returnNo  String          @unique
  saleId    String
  sale      Sale            @relation(fields: [saleId], references: [id])
  total     Int
  note      String?
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  items     SaleReturnItem[]
  createdAt DateTime        @default(now())
  @@index([saleId])
  @@index([createdAt])
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  name         String
  sku          String
  quantity     Float
  unitPrice    Int
  unitCost     Int        @default(0)
  lineTotal    Int
  @@index([saleReturnId])
}

model CustomerPayment {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  amount        Int
  note          String?
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  @@index([customerId, createdAt])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Int
  note       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  @@index([supplierId, createdAt])
}
