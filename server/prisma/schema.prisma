generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE
  CREDIT
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE_RETURN
  PURCHASE_RETURN
}

enum CashMovementType {
  IN
  OUT
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#7488a3")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String              @id @default(cuid())
  sku         String              @unique
  barcode     String?             @unique
  name        String
  unit        String              @default("عدد")
  isWeighted  Boolean             @default(false)
  expiryDate  DateTime?
  price       Int
  wholesalePrice Int?
  wholesaleMinQty Float?
  cost        Int                 @default(0)
  stock       Float               @default(0)
  minStock    Float               @default(0)
  /// Backroom quantity - goods stored away from the sales shelf.
  backstock   Float               @default(0)
  isActive    Boolean             @default(true)
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems   SaleItem[]
  movements   InventoryMovement[]
  purchaseItems PurchaseItem[]
  returnItems   SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  batches             ProductBatch[]
  stocktakeLines      StocktakeLine[]
  quoteItems          QuoteItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  @@index([name])
  @@index([categoryId])
}

model Customer {
  id          String  @id @default(cuid())
  name        String
  phone       String?
  address     String?
  note        String?
  /// 0 = no credit-limit check.
  creditLimit Int     @default(0)
  isActive    Boolean @default(true)
  sales     Sale[]
  payments  CustomerPayment[]
  quotes    Quote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([phone])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  address   String?
  note      String?
  isActive  Boolean           @default(true)
  purchases Purchase[]
  payments  SupplierPayment[]
  purchaseReturns PurchaseReturn[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@index([name])
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  displayName  String
  passwordHash String
  role         UserRole    @default(CASHIER)
  isActive     Boolean     @default(true)
  sales        Sale[]
  cashSessions CashSession[]
  purchases    Purchase[]
  saleReturns  SaleReturn[]
  expenses     Expense[]
  purchaseReturns PurchaseReturn[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  stocktakes        Stocktake[]
  quotes            Quote[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Sale {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  idempotencyKey String?       @unique
  subtotal       Int
  discount       Int           @default(0)
  total          Int
  amountPaid     Int
  change         Int           @default(0)
  /// How the total was settled; backfilled for old rows from paymentMethod.
  cashPart       Int           @default(0)
  mobilePart     Int           @default(0)
  creditPart     Int           @default(0)
  /// Daily sequential number for printed invoices (INV-YYYYMMDD-NNNN).
  invoiceNo      String?       @unique
  paymentMethod  PaymentMethod
  note           String?
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  cashSessionId  String?
  cashSession    CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  returns        SaleReturn[]
  quotes         Quote[]
  createdAt      DateTime      @default(now())
  @@index([createdAt])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  sku       String
  quantity  Float
  unitPrice Int
  unitCost  Int     @default(0)
  /// Manual per-line discount in whole afghani.
  discount  Int     @default(0)
  lineTotal Int
  @@index([saleId])
}

model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Float
  stockAfter Float
  reference String?
  note      String?
  createdAt DateTime     @default(now())
  @@index([productId, createdAt])
}

model CashSession {
  id          String       @id @default(cuid())
  status      String       @default("OPEN")
  openingCash Int
  expectedCash Int?
  countedCash Int?
  note        String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  sales       Sale[]
  movements   CashMovement[]
  customerPayments CustomerPayment[]
  expenses    Expense[]
  openedAt    DateTime     @default(now())
  closedAt    DateTime?
  @@index([status, openedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  amount        Int
  description   String
  cashSessionId String
  cashSession   CashSession       @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  @@index([cashSessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
  @@index([entity, createdAt])
}

model Purchase {
  id         String         @id @default(cuid())
  invoiceNo  String?
  note       String?
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  total      Int
  paidAmount Int            @default(0)
  items      PurchaseItem[]
  purchaseReturns PurchaseReturn[]
  batches         ProductBatch[]
  createdAt  DateTime       @default(now())
  @@index([createdAt])
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  sku        String
  quantity   Float
  unitCost   Int
  lineTotal  Int
  /// Optional batch/lot expiry for this delivery (feeds ProductBatch).
  expiryDate DateTime?
  @@index([purchaseId])
}

model SaleReturn {
  id        String          @id @default(cuid())
  returnNo  String          @unique
  saleId    String
  sale      Sale            @relation(fields: [saleId], references: [id])
  total     Int
  /// Portion of the customer's credit debt forgiven by this return.
  creditRelief Int          @default(0)
  /// Portion of `total` that was paid out of the drawer in cash.
  cashAmount Int            @default(0)
  note      String?
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  items     SaleReturnItem[]
  createdAt DateTime        @default(now())
  @@index([saleId])
  @@index([createdAt])
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  name         String
  sku          String
  quantity     Float
  unitPrice    Int
  unitCost     Int        @default(0)
  lineTotal    Int
  @@index([saleReturnId])
}

model CustomerPayment {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  amount        Int
  note          String?
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  @@index([customerId, createdAt])
}

model Expense {
  id            String       @id @default(cuid())
  title         String
  amount        Int
  category      String?
  note          String?
  fromCash      Boolean      @default(false)
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  @@index([createdAt])
}

model PurchaseReturn {
  id         String               @id @default(cuid())
  returnNo   String               @unique
  purchaseId String?
  purchase   Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  total      Int
  note       String?
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  items      PurchaseReturnItem[]
  createdAt  DateTime             @default(now())
  @@index([createdAt])
  @@index([supplierId])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  name             String
  sku              String
  quantity         Float
  unitCost         Int
  lineTotal        Int
  @@index([purchaseReturnId])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Int
  note       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  @@index([supplierId, createdAt])
}


/// A physical stock count: expected vs counted per product, applied as
/// adjustments either immediately or later from the history.
model Stocktake {
  id        String          @id @default(cuid())
  name      String?
  note      String?
  status    String          @default("OPEN") // OPEN | APPLIED | VOID
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  lines     StocktakeLine[]
  createdAt DateTime        @default(now())
  appliedAt DateTime?
  @@index([createdAt])
}

model StocktakeLine {
  id          String    @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  expected    Float
  counted     Float
  diff        Float
  @@index([stocktakeId])
}

/// A saved pre-invoice: a cart frozen server-side that can be printed,
/// voided, or converted into a real sale.
model Quote {
  id          String      @id @default(cuid())
  quoteNo     String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  note        String?
  total       Int
  status      String      @default("OPEN") // OPEN | CONVERTED | VOID
  saleId      String?
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  createdAt   DateTime    @default(now())
  convertedAt DateTime?
  @@index([status, createdAt])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  sku       String
  quantity  Float
  unitPrice Int
  lineTotal Int
  @@index([quoteId])
}

/// Batch/lot overlay for expiry tracking: quantities are deducted FEFO on
/// sale (best effort) and never gate the money/stock math.
model ProductBatch {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  expiryDate   DateTime
  initialQty   Float
  remainingQty Float
  purchaseId   String?
  purchase     Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  @@index([productId, expiryDate])
}
